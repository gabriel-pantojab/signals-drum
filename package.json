{
  "name": "signals-drum",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/signals-drum.cjs",
  "module": "./dist/signals-drum.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/signals-drum.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/signals-drum.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.12",
    "vite-plugin-dts": "^5.0.1"
  }
}
